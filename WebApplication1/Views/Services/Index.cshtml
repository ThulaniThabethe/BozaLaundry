@model IEnumerable<WebApplication1.Models.Service>

@{ 
    ViewBag.Title = "Services";
}

<!-- Modern Page Header -->
<div class="page-header-modern">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="page-title">
                    <i class="fas fa-concierge-bell me-2"></i>Our Services
                </h1>
                <p class="page-subtitle">Explore the range of services we offer to keep your laundry fresh and clean</p>
            </div>
            <div class="col-md-6 text-end">
                <a href="@Url.Action("Create", "Services")" class="btn btn-primary-modern">
                    <i class="fas fa-plus-circle me-2"></i>Add New Service
                </a>
            </div>
        </div>
    </div>
</div>

<div class="container mt-4">
    <!-- Service Stats -->
    <div class="row mb-4">
        @if (Model == null || !Model.Any())
        {
            <div class="col-12">
                <div class="text-center py-5 fade-in">
                    <div class="mb-4">
                        <svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg" class="mx-auto text-muted empty-state-icon">
                            <circle cx="60" cy="60" r="60" fill="#f8f9fa"/>
                            <path d="M30 40h60v50H30z" fill="#dee2e6" rx="5"/>
                            <path d="M40 55h40v4H40z" fill="#adb5bd"/>
                            <path d="M40 65h30v4H40z" fill="#adb5bd"/>
                            <path d="M40 75h25v4H40z" fill="#adb5bd"/>
                            <circle cx="60" cy="25" r="8" fill="#e9ecef"/>
                            <path d="M60 33l8 8H52l8-8z" fill="#dee2e6"/>
                        </svg>
                    </div>
                    <h4 class="text-muted mb-2">No services available</h4>
                    <p class="text-muted mb-4">Start by adding your first laundry service.</p>
                    <a href="@Url.Action("Create", "Services")" class="btn btn-primary">
                        <i class="fas fa-plus me-2"></i>Add Your First Service
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="col-md-4">
                <div class="card card-modern text-center">
                    <div class="card-body">
                        <div class="stat-icon mb-2">
                            <i class="fas fa-concierge-bell text-primary" style="font-size: 2rem;"></i>
                        </div>
                        <h3 class="stat-number">@Model.Count()</h3>
                        <p class="stat-label text-muted">Total Services</p>
                    </div>
                </div>
            </div>
        <div class="col-md-4">
            <div class="card card-modern text-center">
                <div class="card-body">
                    <div class="stat-icon mb-2">
                        <i class="fas fa-dollar-sign text-success" style="font-size: 2rem;"></i>
                    </div>
                    <h3 class="stat-number">R @Model.Average(s => s.Price).ToString("0.00")</h3>
                    <p class="stat-label text-muted">Average Price</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-modern text-center">
                <div class="card-body">
                    <div class="stat-icon mb-2">
                        <i class="fas fa-clock text-info" style="font-size: 2rem;"></i>
                    </div>
                    <h3 class="stat-number">@Model.Average(s => s.Duration).ToString("0")</h3>
                    <p class="stat-label text-muted">Avg Duration (hrs)</p>
                </div>
            </div>
        </div>
        }

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-4">
            <div class="card card-modern h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-list me-2"></i>View All Services
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Browse through our complete list of services, including washing, drying, folding, and special care options.</p>
                    <a href="@Url.Action("ServiceList", "Services")" class="btn btn-outline-primary w-100">
                        <i class="fas fa-arrow-right me-2"></i>Learn More
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-modern h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Add New Service
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Offer a new service to your customers. Define its name, description, and pricing.</p>
                    <a href="@Url.Action("Create", "Services")" class="btn btn-outline-success w-100">
                        <i class="fas fa-plus me-2"></i>Create Service
                    </a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card card-modern h-100">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-cogs me-2"></i>Manage Services
                    </h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Edit or delete existing services. Keep your service offerings up-to-date and accurate.</p>
                    <a href="@Url.Action("ServiceList", "Services")" class="btn btn-outline-info w-100">
                        <i class="fas fa-tasks me-2"></i>Manage Services
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Popular Services Preview -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card card-modern">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-star me-2"></i>Popular Services
                    </h5>
                </div>
                <div class="card-body">
                    <div id="servicesLoading" class="text-center py-5 d-none">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading services...</span>
                        </div>
                        <p class="text-muted mt-3">Loading services...</p>
                    </div>
                    <div class="row">
                        @foreach (var service in Model.Take(6))
                        {
                            <div class="col-md-4 mb-3">
                                <div class="service-card-modern p-3 border rounded">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <h6 class="mb-0">@service.ServiceName</h6>
                                        <span class="badge bg-primary">R @service.Price</span>
                                    </div>
                                    <p class="text-muted mb-2">@service.Description</p>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="fas fa-clock me-1"></i>@service.Duration hrs
                                        </small>
                                        <div class="btn-group" role="group">
                                            <a href="@Url.Action("Details", "Services", new { id = service.ServiceId })" 
                                               class="btn btn-sm btn-outline-info" title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a href="@Url.Action("Edit", "Services", new { id = service.ServiceId })" 
                                               class="btn btn-sm btn-outline-primary" title="Edit Service">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="text-center mt-3">
                        <a href="@Url.Action("ServiceList", "Services")" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-right me-2"></i>View All Services
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Show loading state for services
        function showServicesLoading() {
            document.getElementById('servicesLoading').classList.remove('d-none');
            document.querySelector('.row').style.opacity = '0.5';
        }

        // Hide loading state for services
        function hideServicesLoading() {
            document.getElementById('servicesLoading').classList.add('d-none');
            document.querySelector('.row').style.opacity = '1';
        }

        // Simulate loading on page load
        document.addEventListener('DOMContentLoaded', function() {
            showServicesLoading();
            setTimeout(hideServicesLoading, 600);
        });
    </script>
}