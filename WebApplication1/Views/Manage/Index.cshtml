@model WebApplication1.Models.IndexViewModel
@{
    ViewBag.Title = "Manage Account";
    var userProfile = ViewBag.UserProfile as WebApplication1.Models.ApplicationUser;
}

<div class="page-header-modern">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="page-title">@ViewBag.Title</h1>
                <p class="page-subtitle">Manage your account settings and profile information</p>
            </div>
            <div class="col-md-4 text-md-right">
                <div class="d-flex align-items-center justify-content-md-end">
                    <div class="user-avatar mr-3">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="24" cy="24" r="24" fill="#e3f2fd"/>
                            <path d="M24 26c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7z" fill="#1976d2"/>
                            <path d="M31 34c0-3.866-3.134-7-7-7s-7 3.134-7 7v2h14v-2z" fill="#1976d2"/>
                        </svg>
                    </div>
                    <div>
                        <h5 class="mb-0">@(userProfile?.FirstName + " " + userProfile?.LastName)</h5>
                        <small class="text-muted">@userProfile?.Email</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<p class="text-success">@ViewBag.StatusMessage</p>

<div class="row">
    <div class="col-md-12">
        <div class="card-modern mb-4">
            <div class="card-header-modern">
                <h3 class="card-title-modern">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-2">
                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z" fill="currentColor"/>
                    </svg>
                    Profile Information
                </h3>
            </div>
            <div class="card-body-modern">
                <div class="row">
                    <div class="col-md-6">
                        <div class="profile-info-item">
                            <label class="profile-info-label">Full Name</label>
                            <p class="profile-info-value">@(userProfile?.FirstName + " " + userProfile?.LastName)</p>
                        </div>
                        <div class="profile-info-item">
                            <label class="profile-info-label">Email Address</label>
                            <p class="profile-info-value">@userProfile?.Email</p>
                        </div>
                        <div class="profile-info-item">
                            <label class="profile-info-label">Phone Number</label>
                            <p class="profile-info-value">@(userProfile?.PhoneNumber ?? "Not provided")</p>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="profile-info-item">
                            <label class="profile-info-label">Address</label>
                            <p class="profile-info-value">@(userProfile?.Address ?? "Not provided")</p>
                        </div>
                        <div class="profile-info-item">
                            <label class="profile-info-label">City</label>
                            <p class="profile-info-value">@(userProfile?.City ?? "Not provided")</p>
                        </div>
                        <div class="profile-info-item">
                            <label class="profile-info-label">State & ZIP</label>
                            <p class="profile-info-value">@(userProfile?.State + " " + userProfile?.ZipCode)</p>
                        </div>
                    </div>
                </div>
                <div class="mt-4">
                    <a href="@Url.Action("UpdateProfile", "Manage")" class="btn btn-primary-modern">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-2">
                            <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" fill="currentColor"/>
                        </svg>
                        Update Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card-modern">
            <div class="card-header-modern">
                <h3 class="card-title-modern">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="mr-2">
                        <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z" fill="currentColor"/>
                    </svg>
                    Account Settings
                </h3>
            </div>
            <div class="card-body-modern">
                <div class="settings-list">
                    <div class="settings-item">
                        <div class="settings-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" fill="currentColor"/>
                            </svg>
                        </div>
                        <div class="settings-content">
                            <h5 class="settings-title">Password</h5>
                            <p class="settings-description">Change your account password</p>
                        </div>
                        <div class="settings-action">
                            <a href="@Url.Action("ChangePassword", "Manage")" class="btn btn-outline-primary btn-sm">Change</a>
                        </div>
                    </div>
                    
                    <div class="settings-item">
                        <div class="settings-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                            </svg>
                        </div>
                        <div class="settings-content">
                            <h5 class="settings-title">External Logins</h5>
                            <p class="settings-description">Manage your connected social accounts (@Model.Logins.Count connected)</p>
                        </div>
                        <div class="settings-action">
                            <a href="@Url.Action("ManageLogins")" class="btn btn-outline-primary btn-sm">Manage</a>
                        </div>
                    </div>
                    
                    <div class="settings-item">
                        <div class="settings-icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" fill="currentColor"/>
                            </svg>
                        </div>
                        <div class="settings-content">
                            <h5 class="settings-title">Two-Factor Authentication</h5>
                            <p class="settings-description">Add an extra layer of security to your account</p>
                        </div>
                        <div class="settings-action">
                            @if (Model.TwoFactor)
                            {
                                <a href="@Url.Action("DisableTwoFactorAuthentication", "Manage")" class="btn btn-outline-danger btn-sm">Disable</a>
                            }
                            else
                            {
                                <a href="@Url.Action("EnableTwoFactorAuthentication", "Manage")" class="btn btn-outline-success btn-sm">Enable</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>