@{
    ViewBag.Title = "About BozaLaundry";
}

<!-- Modern Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center min-vh-50">
            <div class="col-lg-8 mx-auto text-center">
                <h1 class="hero-title">@ViewBag.Title</h1>
                <p class="hero-subtitle">@ViewBag.Message</p>
                <div class="mt-4">
                    <svg width="300" height="200" viewBox="0 0 300 200" class="img-fluid">
                        <defs>
                            <linearGradient id="aboutGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" style="stop-color:white;stop-opacity:0.9" />
                                <stop offset="100%" style="stop-color:white;stop-opacity:0.6" />
                            </linearGradient>
                        </defs>
                        <!-- Building -->
                        <rect x="50" y="80" width="80" height="80" fill="url(#aboutGradient)" rx="5"/>
                        <rect x="60" y="90" width="15" height="15" fill="var(--primary-color)" rx="2"/>
                        <rect x="85" y="90" width="15" height="15" fill="var(--primary-color)" rx="2"/>
                        <rect x="60" y="115" width="15" height="15" fill="var(--primary-color)" rx="2"/>
                        <rect x="85" y="115" width="15" height="15" fill="var(--primary-color)" rx="2"/>
                        
                        <!-- Clock -->
                        <circle cx="180" cy="120" r="30" fill="url(#aboutGradient)"/>
                        <circle cx="180" cy="120" r="25" fill="none" stroke="var(--primary-color)" stroke-width="3"/>
                        <line x1="180" y1="120" x2="180" y2="105" stroke="var(--primary-color)" stroke-width="3"/>
                        <line x1="180" y1="120" x2="190" y2="120" stroke="var(--primary-color)" stroke-width="2"/>
                        <circle cx="180" cy="120" r="3" fill="var(--primary-color)"/>
                        
                        <!-- Sparkles -->
                        <g fill="white" opacity="0.8">
                            <path d="M220 60 L223 65 L228 65 L224 68 L225 73 L220 70 L215 73 L216 68 L212 65 L217 65 Z"/>
                            <path d="M260 80 L262 83 L265 83 L263 85 L264 88 L260 86 L256 88 L257 85 L255 83 L258 83 Z"/>
                        </g>
                        
                        <!-- Checkmark -->
                        <path d="M30 140 L40 150 L55 125" stroke="white" stroke-width="4" fill="none" stroke-linecap="round"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">

    <div class="row mb-5">
        <div class="col-md-8 offset-md-2">
            <div class="text-center">
                <h2>Our Story</h2>
                <p class="lead">
                    Founded in @ViewBag.FoundedYear, BozaLaundry has been providing professional laundry services 
                    to our community with dedication and excellence. We understand that your time is valuable, 
                    and we're here to make your life easier by taking care of all your laundry needs.
                </p>
                <p>
                    Our state-of-the-art facilities and experienced staff ensure that your clothes receive 
                    the best care possible. From everyday wear to delicate fabrics, we handle each item 
                    with the attention it deserves.
                </p>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-4 text-center">
            <div class="card h-100 border-0">
                <div class="card-body">
                    <i class="fas fa-tshirt fa-3x text-primary mb-3"></i>
                    <h4>Quality Service</h4>
                    <p>We use premium detergents and advanced cleaning techniques to ensure your clothes look their best.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-center">
            <div class="card h-100 border-0">
                <div class="card-body">
                    <i class="fas fa-clock fa-3x text-primary mb-3"></i>
                    <h4>Fast Turnaround</h4>
                    <p>Quick and efficient service with same-day and next-day options available for your convenience.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-center">
            <div class="card h-100 border-0">
                <div class="card-body">
                    <i class="fas fa-leaf fa-3x text-primary mb-3"></i>
                    <h4>Eco-Friendly</h4>
                    <p>Environmentally conscious practices with eco-friendly products and energy-efficient processes.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-12">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <div class="row">
                        <div class="col-md-3">
                            <h3 class="text-primary">@ViewBag.ServicesCount</h3>
                            <p>Services Offered</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-primary">@ViewBag.CustomersServed</h3>
                            <p>Happy Customers</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-primary">99%</h3>
                            <p>Customer Satisfaction</p>
                        </div>
                        <div class="col-md-3">
                            <h3 class="text-primary">24/7</h3>
                            <p>Online Support</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 text-center">
            <h2>Ready to Experience the Difference?</h2>
            <p class="lead">Join thousands of satisfied customers who trust BozaLaundry with their laundry needs.</p>
            @if (Request.IsAuthenticated)
            {
                <a href="@Url.Action("Index", "LaundryOrders")" class="btn btn-primary btn-lg">Place an Order</a>
            }
            else
            {
                <a href="@Url.Action("Register", "Account")" class="btn btn-primary btn-lg">Get Started</a>
                <span class="mx-2">or</span>
                <a href="@Url.Action("Login", "Account")" class="btn btn-outline-primary btn-lg">Sign In</a>
            }
        </div>
    </div>
</div>